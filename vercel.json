{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://did-job.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "didcv.vercel.app"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/scrape?batch_size=20",
      "schedule": "0 12 * * *"
    }
  ]
}