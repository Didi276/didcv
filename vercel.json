{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/interview-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/scrape?batch_size=20",
      "schedule": "0 */6 * * *"
    }
  ]
}